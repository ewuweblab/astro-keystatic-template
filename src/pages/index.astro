---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { siteName } from '../consts';

const posts = await getCollection('posts');
---

<Layout title={siteName}>
  <section class="mb-14">

    <h1 class="text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl dark:text-white">
      {siteName}
    </h1>
    <p class="mt-4 max-w-xl text-lg text-zinc-600 dark:text-zinc-400">
      A short introduction to the site goes here. Replace this text with what your blog is about.
    </p>
  </section>

  <section aria-labelledby="posts-heading">
    <h2 id="posts-heading" class="mb-4 text-sm font-semibold tracking-wide text-zinc-500 uppercase dark:text-zinc-400">
      Posts
    </h2>
    {posts.length > 0 ? (
      <ul class="divide-y divide-zinc-200 border-y border-zinc-200 dark:divide-zinc-800 dark:border-zinc-800">
        {posts.map((post) => (
          <li>
            <a
              href={`/posts/${post.id}/`}
              class="group flex items-center justify-between gap-4 py-4 text-lg font-medium text-zinc-900 dark:text-zinc-100"
            >
              <span class="transition group-hover:text-accent-600 dark:group-hover:text-accent-400">{post.data.title}</span>
              <span aria-hidden="true" class="text-zinc-400 transition group-hover:translate-x-1 group-hover:text-accent-600 dark:group-hover:text-accent-400">→</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="rounded-xl border border-dashed border-zinc-300 p-8 text-center text-zinc-500 dark:border-zinc-700">
        No posts yet. Add one in <a href="/keystatic" class="font-medium text-accent-600 hover:underline dark:text-accent-400">Keystatic</a>.
      </p>
    )}
  </section>
</Layout>
